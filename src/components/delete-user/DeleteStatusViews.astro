---
// Component for the Confirmation (Success) and Error Status Views
---

<!-- Success Confirmation View (Shown on 200 OK) -->
<div id="confirmation-view" class="flow-view hidden">
  <div class="tech-card status-result-card success-card">
    <div class="result-badge font-mono badge-success">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span>CONFIRMATION: 200 OK // ACCOUNT DELETED</span>
    </div>

    <h2 class="result-title font-mono">Account Successfully Deleted</h2>
    <p class="result-lead">
      Your DeezChatz account record and pre-key bundles have been permanently deleted from the backend servers. All registered devices have been disconnected.
    </p>

    <div class="deletion-details font-mono">
      <div class="detail-row">
        <span class="detail-label">AUTHENTICATED IDENTITY:</span>
        <span id="confirmed-user-email" class="detail-val">user@example.com</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">BACKEND REGISTRY:</span>
        <span class="detail-val text-green">PURGED &amp; TERMINATED</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">DEVICE TOKENS:</span>
        <span class="detail-val text-green">DISCONNECTED</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">TIMESTAMP:</span>
        <span id="confirmed-timestamp" class="detail-val">--</span>
      </div>
    </div>

    <!-- Reminder Callout on Confirmation Screen -->
    <div class="persistence-reminder">
      <div class="reminder-tag font-mono">FINAL LOCAL DATA STEP</div>
      <p>
        <strong>Remember:</strong> Because DeezChatz operates on a zero-knowledge architecture, local chats still persist on any registered apps and devices. Please <strong>uninstall the DeezChatz applications</strong> from your devices to delete all locally stored encrypted conversations and cryptographic ratchets.
      </p>
    </div>

    <div class="result-actions">
      <a href="/" class="btn-tech btn-tech-primary">
        Return to Homepage
      </a>
    </div>
  </div>
</div>

<!-- Error View (Shown on non-200 or failure) -->
<div id="error-view" class="flow-view hidden">
  <div class="tech-card status-result-card error-card">
    <div class="result-badge font-mono badge-danger">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="15" y1="9" x2="9" y2="15"></line>
        <line x1="9" y1="9" x2="15" y2="15"></line>
      </svg>
      <span>STATUS ERROR // DELETION NOT COMPLETED</span>
    </div>

    <h2 class="result-title font-mono">Account Deletion Failed</h2>
    <p class="result-lead">
      The backend server encountered an error while attempting to process your account deletion. Your account has <strong>not</strong> been deleted.
    </p>

    <div class="error-box font-mono">
      <div class="error-header">ERROR DIAGNOSTICS:</div>
      <div id="error-message-text" class="error-text">
        An unexpected network error occurred or the backend rejected the deletion request.
      </div>
      <div id="error-code-badge" class="error-status">HTTP STATUS: 500</div>
    </div>

    <div class="result-actions">
      <button id="retry-deletion-btn" type="button" class="btn-tech btn-tech-primary">
        Try Again
      </button>
      <a href="mailto:privacy@deez.in?subject=Account%20Deletion%20Assistance" class="btn-tech btn-tech-outline">
        Contact Privacy Support
      </a>
      <a href="/" class="btn-tech btn-tech-outline">
        Return Home
      </a>
    </div>
  </div>
</div>

<style>
  /* Status Result Cards (Confirmation & Error) */
  .status-result-card {
    max-width: 52rem;
    margin-inline: auto;
    padding: 3rem;
  }

  .result-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.5rem;
  }

  .badge-success {
    background-color: rgba(34, 197, 94, 0.12);
    border: 1px solid #22c55e;
    color: #16a34a;
  }

  :global(html.dark) .badge-success {
    color: #4ade80;
  }

  .badge-danger {
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid #ef4444;
    color: #dc2626;
  }

  :global(html.dark) .badge-danger {
    color: #f87171;
  }

  .result-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .result-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .deletion-details {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    font-size: 0.8125rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .detail-label {
    color: var(--text-muted);
  }

  .detail-val {
    color: var(--text-primary);
    font-weight: 700;
  }

  .text-green {
    color: #16a34a;
  }
  :global(html.dark) .text-green {
    color: #4ade80;
  }

  .persistence-reminder {
    background-color: var(--accent-primary-light);
    border: 1px solid var(--accent-primary-glow);
    border-left: 3px solid var(--accent-primary);
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    margin-bottom: 2.5rem;
    font-size: 0.9375rem;
    color: var(--text-primary);
    line-height: 1.6;
  }

  .reminder-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: 0.35rem;
    letter-spacing: 0.05em;
  }

  .result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Error Box */
  .error-box {
    background-color: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    margin-bottom: 2rem;
    font-size: 0.8125rem;
  }

  .error-header {
    font-weight: 700;
    color: #dc2626;
    margin-bottom: 0.5rem;
  }
  :global(html.dark) .error-header {
    color: #f87171;
  }

  .error-text {
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .error-status {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background-color: rgba(239, 68, 68, 0.2);
    border-radius: var(--radius-sm);
    color: #dc2626;
    font-weight: 700;
  }
  :global(html.dark) .error-status {
    color: #fca5a5;
  }
</style>
