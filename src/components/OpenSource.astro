---
---

<section id="opensource" class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">
        <span class="pulse-indicator"></span>
        <span>Freedom &amp; Auditing</span>
      </div>
      <h2 class="section-title">100% Free &amp; Open Source</h2>
      <p class="section-subtitle">
        Cryptography that cannot be audited cannot be trusted. Every single line of code in our mobile apps, relay daemons, and cryptographic crates is public under open source licenses.
      </p>
    </div>

    <!-- Dual Open Source Cards Grid -->
    <div class="os-grid">
      <!-- Card 1: deezchatz-api -->
      <div class="tech-card os-card">
        <div class="github-watermark" aria-hidden="true">
          <svg width="150" height="150" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
          </svg>
        </div>

        <div class="os-content">
          <div class="repo-badge font-mono">
            <span class="repo-type">BACKEND ENGINE</span>
            <span class="repo-license">LICENSE: MIT</span>
          </div>

          <h3 class="repo-name font-mono">deez-in/deezchatz-api</h3>
          <p class="repo-desc">
            Zero-trust Rust &amp; Axum backend server. Handles Google OAuth token verification, DynamoDB pre-key bundle storage, Redis caching, and RMQTT webhook-triggered push wake-ups.
          </p>

          <div class="cli-box font-mono">
            <span class="cli-prompt">$</span>
            <span class="cli-command">git clone https://github.com/deez-in/deezchatz-api.git &amp;&amp; cargo build --release</span>
          </div>

          <div class="os-actions">
            <a href="https://github.com/deez-in/deezchatz-api" target="_blank" rel="noopener noreferrer" class="btn-tech btn-tech-primary font-mono">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
              </svg>
              <span>View deezchatz-api &nearr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2: deezchatz-mobile -->
      <div class="tech-card os-card">
        <div class="github-watermark" aria-hidden="true">
          <svg width="150" height="150" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
          </svg>
        </div>

        <div class="os-content">
          <div class="repo-badge font-mono">
            <span class="repo-type">MOBILE CLIENT</span>
            <span class="repo-license">LICENSE: AGPL-3.0</span>
          </div>

          <h3 class="repo-name font-mono">deez-in/deezchatz-mobile</h3>
          <p class="repo-desc">
            Cross-platform React Native mobile app (Expo SDK 57). Features Zustand state management, SQLCipher encrypted SQLite DB, native Google OAuth, and Rust C-FFI Signal Protocol bridge.
          </p>

          <div class="cli-box font-mono">
            <span class="cli-prompt">$</span>
            <span class="cli-command">git clone https://github.com/deez-in/deezchatz-mobile.git &amp;&amp; bun install</span>
          </div>

          <div class="os-actions">
            <a href="https://github.com/deez-in/deezchatz-mobile" target="_blank" rel="noopener noreferrer" class="btn-tech btn-tech-primary font-mono">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
              </svg>
              <span>View deezchatz-mobile &nearr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .os-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .os-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .os-card {
    padding: 2.25rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .github-watermark {
    position: absolute;
    top: -1rem;
    right: -1rem;
    opacity: 0.04;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .os-card:hover .github-watermark {
    opacity: 0.09;
    transform: scale(1.05);
  }

  .os-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .repo-badge {
    display: flex;
    gap: 0.75rem;
    font-size: 0.6875rem;
    margin-bottom: 1rem;
  }

  .repo-type {
    color: var(--accent-primary);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .repo-license {
    color: var(--text-muted);
  }

  .repo-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .repo-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .cli-box {
    background-color: var(--terminal-bg);
    border: 1px solid var(--terminal-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    color: var(--terminal-text);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.75rem;
    overflow-x: auto;
  }

  .cli-prompt {
    color: var(--accent-primary);
    font-weight: 700;
    user-select: none;
  }

  .cli-command {
    color: var(--terminal-text);
  }

  .os-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
  }
</style>
