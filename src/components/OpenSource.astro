---
---

<section id="opensource" class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">
        <span>Freedom &amp; Auditing</span>
      </div>
      <h2 class="section-title">100% Free &amp; Open Source</h2>
      <p class="section-subtitle">
        Cryptography that cannot be audited cannot be trusted. Every single line of code in our mobile apps, relay daemons, and cryptographic crates is public under open source licenses.
      </p>
    </div>

    <!-- Dual Open Source Cards Grid -->
    <div class="os-grid">
      <!-- Card 1: deezchatz-api -->
      <div class="tech-card os-card">
        <div class="github-watermark" aria-hidden="true">
          <svg width="150" height="150" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
          </svg>
        </div>

        <div class="os-content">
          <div class="repo-badge font-mono">
            <span class="repo-type">BACKEND ENGINE</span>
            <span class="repo-license">LICENSE: MIT</span>
          </div>

          <h3 class="repo-name font-mono">deez-in/deezchatz-api</h3>
          <p class="repo-desc">
            Zero-trust Rust &amp; Axum backend server. Handles Google OAuth token verification, DynamoDB pre-key bundle storage, Redis caching, and RMQTT webhook-triggered push wake-ups.
          </p>

          <div class="cli-box font-mono">
            <div class="cli-code">
              <span class="cli-prompt">$</span>
              <span class="cli-command">git clone https://github.com/deez-in/deezchatz-api.git &amp;&amp; cargo build --release</span>
            </div>
            <button class="cli-copy-btn font-mono" aria-label="Copy clone command" data-copy="git clone https://github.com/deez-in/deezchatz-api.git && cargo build --release">
              <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>

          <div class="os-actions">
            <a href="https://github.com/deez-in/deezchatz-api" target="_blank" rel="noopener noreferrer" class="btn-tech btn-tech-primary font-mono">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
              </svg>
              <span>View deezchatz-api &nearr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2: deezchatz-mobile -->
      <div class="tech-card os-card">
        <div class="github-watermark" aria-hidden="true">
          <svg width="150" height="150" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
          </svg>
        </div>

        <div class="os-content">
          <div class="repo-badge font-mono">
            <span class="repo-type">MOBILE CLIENT</span>
            <span class="repo-license">LICENSE: AGPL-3.0</span>
          </div>

          <h3 class="repo-name font-mono">deez-in/deezchatz-mobile</h3>
          <p class="repo-desc">
            Cross-platform React Native mobile app (Expo SDK 57). Features Zustand state management, SQLCipher encrypted SQLite DB, native Google OAuth, and Rust C-FFI Signal Protocol bridge.
          </p>

          <div class="cli-box font-mono">
            <div class="cli-code">
              <span class="cli-prompt">$</span>
              <span class="cli-command">git clone https://github.com/deez-in/deezchatz-mobile.git &amp;&amp; bun install</span>
            </div>
            <button class="cli-copy-btn font-mono" aria-label="Copy clone command" data-copy="git clone https://github.com/deez-in/deezchatz-mobile.git && bun install">
              <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>

          <div class="os-actions">
            <a href="https://github.com/deez-in/deezchatz-mobile" target="_blank" rel="noopener noreferrer" class="btn-tech btn-tech-primary font-mono">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
              </svg>
              <span>View deezchatz-mobile &nearr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Secondary Repositories Grid -->
    <div class="os-secondary-grid">
      <div class="tech-card os-mini-card">
        <div class="mini-header font-mono">
          <span class="mini-type">CRYPTO ENGINE</span>
          <span class="mini-license">MIT / APACHE-2.0</span>
        </div>
        <h4 class="mini-title font-mono">deez-in/libsignal-dezire</h4>
        <p class="mini-desc">
          Pure-Rust Signal Protocol implementation (X3DH, Double Ratchet) for high performance and cross-platform FFI.
        </p>
        <a href="https://github.com/deez-in/libsignal-dezire" target="_blank" rel="noopener noreferrer" class="mini-link font-mono">
          View Repository &nearr;
        </a>
      </div>

      <div class="tech-card os-mini-card">
        <div class="mini-header font-mono">
          <span class="mini-type">CLIENT SDK</span>
          <span class="mini-license">MIT</span>
        </div>
        <h4 class="mini-title font-mono">deez-in/deezchatz-sdk-rust</h4>
        <p class="mini-desc">
          Async client SDK encapsulating Signal ratchets, stateless VXEdDSA authentication, and MQTT networking.
        </p>
        <a href="https://github.com/deez-in/deezchatz-sdk-rust" target="_blank" rel="noopener noreferrer" class="mini-link font-mono">
          View Repository &nearr;
        </a>
      </div>

      <div class="tech-card os-mini-card">
        <div class="mini-header font-mono">
          <span class="mini-type">TERMINAL TUI</span>
          <span class="mini-license">GPL-3.0</span>
        </div>
        <h4 class="mini-title font-mono">deez-in/deezchatz-cli</h4>
        <p class="mini-desc">
          Terminal-native client featuring Ratatui TUI, headless scriptable subcommands, and SQLCipher storage.
        </p>
        <a href="https://github.com/deez-in/deezchatz-cli" target="_blank" rel="noopener noreferrer" class="mini-link font-mono">
          View Repository &nearr;
        </a>
      </div>
    </div>

    <!-- View All Repositories CTA -->
    <div class="os-footer-cta">
      <a href="https://github.com/orgs/deez-in/repositories" target="_blank" rel="noopener noreferrer" class="btn-tech btn-tech-outline font-mono">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
        </svg>
        <span>View All Repositories on GitHub &rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .os-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .os-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .os-card {
    padding: 2.25rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .github-watermark {
    position: absolute;
    top: -1rem;
    right: -1rem;
    opacity: 0.04;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .os-card:hover .github-watermark {
    opacity: 0.09;
    transform: scale(1.05);
  }

  .os-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .repo-badge {
    display: flex;
    gap: 0.75rem;
    font-size: 0.6875rem;
    margin-bottom: 1rem;
  }

  .repo-type {
    color: var(--accent-primary);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .repo-license {
    color: var(--text-muted);
  }

  .repo-name {
    font-size: clamp(1.1rem, 4vw, 1.35rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    word-break: break-word;
  }

  .repo-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .cli-box {
    background-color: var(--terminal-bg);
    border: 1px solid var(--terminal-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    color: var(--terminal-text);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .cli-code {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    overflow-x: auto;
    flex: 1;
  }

  .cli-prompt {
    color: var(--accent-primary);
    font-weight: 700;
    user-select: none;
  }

  .cli-command {
    color: var(--terminal-text);
    white-space: nowrap;
  }

  .cli-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.6875rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .cli-copy-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent-primary);
    background-color: var(--accent-primary-light);
  }

  .cli-copy-btn.copied {
    color: #10b981;
    border-color: #10b981;
    background-color: rgba(16, 185, 129, 0.1);
  }

  .os-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
  }

  /* Secondary Repos Grid */
  .os-secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .os-secondary-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .os-mini-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .mini-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    margin-bottom: 0.75rem;
  }

  .mini-type {
    color: var(--accent-primary);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .mini-license {
    color: var(--text-muted);
  }

  .mini-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    word-break: break-word;
  }

  .mini-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .mini-link {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .mini-link:hover {
    color: var(--accent-primary-hover);
    transform: translateX(2px);
  }

  /* Footer CTA */
  .os-footer-cta {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cli-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector('.copy-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            label.textContent = original;
            btn.classList.remove('copied');
          }, 2000);
        }
      } catch (e) {
        console.error('Failed to copy', e);
      }
    });
  });
</script>
