---
---

<div id="crypto-graph-container" class="crypto-graph-wrapper">
  <canvas id="crypto-canvas" aria-label="Interactive Cryptographic Mesh Network Visualizer"></canvas>

  <!-- Left fade mask to prevent canvas lines from distracting foreground text -->
  <div class="graph-fade-mask" aria-hidden="true"></div>

  <!-- HUD Status Info -->
  <div class="graph-hud">
    <div class="hud-status font-mono">
      <span class="pulse-indicator"></span>
      <span id="hud-text">E2EE MESH: AUTONOMOUS ROUTING</span>
    </div>
    <div class="hud-stats font-mono">
      <span>RELAY NODES: 24</span>
      <span class="hud-sep">|</span>
      <span>ZERO METADATA LEAK</span>
    </div>
  </div>

  <button id="close-graph-btn" class="close-graph-button font-mono" title="Exit Interactive Mode" aria-label="Exit Interactive Mode">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
    <span>Lock View</span>
  </button>
</div>

<style>
  .crypto-graph-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.5s ease, background 0.5s ease;
  }

  .graph-fade-mask {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      var(--bg-primary) 0%,
      rgba(8, 9, 13, 0.85) 30%,
      transparent 70%
    );
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  :global(html:not(.dark)) .graph-fade-mask {
    background: linear-gradient(
      to right,
      var(--bg-primary) 0%,
      rgba(248, 249, 250, 0.88) 30%,
      transparent 70%
    );
  }

  .crypto-graph-wrapper.interactive-mode .graph-fade-mask {
    opacity: 0;
  }

  .crypto-graph-wrapper.interactive-mode {
    pointer-events: auto;
    z-index: 30;
    background: radial-gradient(circle at center, rgba(8, 9, 13, 0.92) 0%, rgba(8, 9, 13, 0.98) 100%);
  }

  :global(html:not(.dark)) .crypto-graph-wrapper.interactive-mode {
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.92) 0%, rgba(240, 242, 245, 0.98) 100%);
  }

  #crypto-canvas {
    width: 100%;
    height: 100%;
    display: block;
    position: relative;
    z-index: 0;
  }

  .graph-hud {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0.625rem 1rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    opacity: 0.9;
    pointer-events: none;
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .graph-hud {
      display: none;
    }
  }

  .hud-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-primary);
    font-weight: 700;
  }

  .hud-stats {
    color: var(--text-muted);
  }

  .hud-sep {
    margin-inline: 0.35rem;
    opacity: 0.4;
  }

  .close-graph-button {
    position: absolute;
    top: calc(var(--header-height) + 1.5rem);
    right: 2rem;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 700;
    transition: all 0.2s ease;
    z-index: 40;
  }

  .close-graph-button:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translateY(-1px);
  }

  .crypto-graph-wrapper.interactive-mode .close-graph-button {
    display: flex;
  }
</style>

<script src="../scripts/crypto-graph.ts"></script>
