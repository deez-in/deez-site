---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RepoModal from '../components/RepoModal.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'DeezChatz | Zero-Knowledge End-to-End Encrypted Messaging',
  description = 'DeezChatz is a high-performance, zero-knowledge, end-to-end encrypted messaging platform powered by the Signal Double Ratchet protocol, rust-native core, and metadata-shielding relays.',
  currentPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      />
    </noscript>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="DeezChatz" />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "DeezChatz",
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "Android, iOS, Linux, macOS, Windows",
      "license": "https://opensource.org/licenses/MIT",
      "url": "https://deez.in",
      "description": description
    })} />

    <!-- Anti-FOUC Theme Script -->
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem('deezchatz_theme');
          const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
            document.documentElement.classList.add('dark');
          } else if (storedTheme === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="skip-link font-mono">Skip to content</a>

    <!-- Background Atmosphere & Grid Layer (Deep Background) -->
    <div class="bg-glow-top" aria-hidden="true"></div>
    <div class="bg-grid-overlay" aria-hidden="true"></div>

    <!-- Navigation (Sticky Foreground) -->
    <Navbar currentPath={currentPath} />

    <!-- Main Content (Foreground) -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Repository Commits & Details Modal -->
    <RepoModal />
  </body>
</html>

<style>
  /* Deep Background Atmosphere */
  .bg-glow-top {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    max-width: 1600px;
    height: 600px;
    background: radial-gradient(ellipse at 50% 0%, rgba(250, 204, 21, 0.08) 0%, rgba(250, 204, 21, 0.02) 50%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  :global(html:not(.dark)) .bg-glow-top {
    background: radial-gradient(ellipse at 50% 0%, rgba(202, 138, 4, 0.07) 0%, rgba(202, 138, 4, 0.01) 50%, transparent 70%);
  }

  .bg-grid-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.35;
    background-image: radial-gradient(var(--border-color) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: 0 0;
    mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 80%);
  }

  :global(html.dark) .bg-grid-overlay {
    opacity: 0.22;
  }

  #main-content {
    position: relative;
    z-index: 1;
    min-height: calc(100vh - var(--header-height));
    padding-top: var(--header-height);
  }
</style>
