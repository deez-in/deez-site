---
import Layout from '../layouts/Layout.astro';
import CryptoGraph from '../components/CryptoGraph.astro';
import LiveEncryptionDemo from '../components/LiveEncryptionDemo.astro';
import Ecosystem from '../components/Ecosystem.astro';
import SecurityFeatures from '../components/SecurityFeatures.astro';
import OpenSource from '../components/OpenSource.astro';
import Faq from '../components/Faq.astro';
---

<Layout
  title="DeezChatz | Ain't nobody reading Deez Chats"
  description="Send a private message with DeezChatz. The ultimate encrypted chat app where ain't nobody reading your data. 100% secure, zero-knowledge messaging."
  currentPath="/"
>
  <!-- Hero Section with Distinct Foreground / Background Layering -->
  <section id="hero" class="hero-section">
    <!-- Deep Layer: Background Crypto Mesh Canvas -->
    <CryptoGraph />

    <!-- Foreground Layer: Content with High-Contrast Depth -->
    <div class="container hero-content-container">
      <div class="hero-content">
        <!-- Cryptographic Status Badge -->
        <div class="hero-badge font-mono">
	  <span class="badge-text">SIGNAL PROTOCOL // ENCRYPTED CHATS</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-title font-mono">
          The Ultimate<br />
          <span class="text-accent">Encrypted Chat Ecosystem.</span>
        </h1>

        <!-- Philosophy Quote with Foreground Card Elevation -->
        <div class="hero-quote-card tech-card">
          <blockquote class="hero-quote-text">
            Ain't nobody reading Deez Chatz — not your ISP, not Big Tech, and definitely not us.
          </blockquote>
          <span class="quote-sub font-mono">We don't store your messages, because ain't nobody paying to store deez chats.</span>
        </div>

        <!-- Description Body -->
        <p class="hero-description">
          <strong>DeezChatz</strong> is the only <strong>encrypted chat</strong> app you need. When you want real <strong>privacy</strong> for <strong>deez</strong> conversations, we've got you covered. Lock down your <strong>private chats</strong> with top-tier <strong>encryption</strong>, and keep your business your business.
        </p>

        <!-- CTA Action Buttons -->
        <div class="hero-actions font-mono">
          <a href="https://github.com/deez-in/deezchatz-mobile/releases" target="_blank" rel="noopener noreferrer" class="btn-tech btn-tech-primary hero-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
            </svg>
            <span>Download on GitHub</span>
          </a>

          <button id="explore-graph-btn" class="btn-tech btn-tech-outline hero-btn">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <circle cx="12" cy="12" r="9"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18"></path>
            </svg>
            <span>See the Magic</span>
          </button>

          <a href="#demo" class="btn-tech btn-tech-outline hero-btn">
            <span>Live Demo &darr;</span>
          </a>
        </div>

        <!-- Key Metrics Foreground Strip -->
        <div class="metrics-strip tech-card font-mono">
          <div class="metric-item">
            <span class="metric-num">0</span>
            <span class="metric-label">Messages Stored</span>
          </div>
          <div class="metric-divider">/</div>
          <div class="metric-item">
            <span class="metric-num">100%</span>
            <span class="metric-label">Privacy Guaranteed</span>
          </div>
          <div class="metric-divider">/</div>
          <div class="metric-item">
            <span class="metric-num">Max</span>
            <span class="metric-label">Encryption</span>
          </div>
          <div class="metric-divider">/</div>
          <div class="metric-item">
            <span class="metric-num">Free</span>
            <span class="metric-label">As in FREEDOM</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Ratchet Simulation Section -->
  <LiveEncryptionDemo />

  <!-- Ecosystem / Architecture Crates Section -->
  <Ecosystem />

  <!-- Security Features / Bento Grid Section -->
  <SecurityFeatures />

  <!-- Open Source / GitHub Section -->
  <OpenSource />

  <!-- Technical FAQ & Contact Section -->
  <Faq />
</Layout>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 4.5rem 5.5rem;
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding-block: 6rem 7rem;
    }
  }

  .hero-content-container {
    position: relative;
    z-index: 10;
  }

  .hero-content {
    max-width: 46rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .hero-title {
    font-size: clamp(1.75rem, 6vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .text-accent {
    color: var(--accent-primary);
    background: linear-gradient(135deg, var(--accent-primary) 0%, #fbbf24 60%, var(--accent-cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-quote-card {
    padding: 1.125rem 1.35rem;
    margin-bottom: 1.5rem;
    border-left: 3px solid var(--accent-primary);
    background-color: var(--bg-card);
    max-width: 40rem;
  }

  .hero-quote-text {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    font-style: italic;
    line-height: 1.5;
  }

  .quote-sub {
    color: var(--accent-primary);
    font-weight: 700;
    font-style: normal;
    display: inline-block;
    margin-top: 0.35rem;
    font-size: 0.9375rem;
  }

  .hero-description {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.25rem;
    max-width: 42rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 3.25rem;
    position: relative;
    z-index: 20;
  }

  .hero-btn {
    padding: 0.875rem 1.625rem;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    #explore-graph-btn {
      display: none;
    }
  }

  .metrics-strip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.75rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
  }

  @media (max-width: 640px) {
    .metrics-strip {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      width: 100%;
    }
    .metric-divider {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .metrics-strip {
      grid-template-columns: 1fr;
    }
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .metric-label {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-divider {
    color: var(--border-color);
    font-weight: 300;
  }
</style>

<script>
  const exploreBtn = document.getElementById('explore-graph-btn');
  exploreBtn?.addEventListener('click', () => {
    if (typeof (window as any).toggleCryptoGraph === 'function') {
      (window as any).toggleCryptoGraph();
    }
  });
</script>
