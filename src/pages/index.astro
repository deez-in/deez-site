---
import Layout from '../layouts/Layout.astro';
import CryptoGraph from '../components/CryptoGraph.astro';
import LiveEncryptionDemo from '../components/LiveEncryptionDemo.astro';
import Ecosystem from '../components/Ecosystem.astro';
import SecurityFeatures from '../components/SecurityFeatures.astro';
import OpenSource from '../components/OpenSource.astro';
import Faq from '../components/Faq.astro';
---

<Layout
  title="DeezChatz | Ain't nobody reading Deez Chats"
  description="Send a private message with DeezChatz. The ultimate encrypted chat app where ain't nobody reading your data. 100% secure, zero-knowledge messaging."
  currentPath="/"
>
  <!-- Hero Section with Distinct Foreground / Background Layering -->
  <section id="hero" class="hero-section">
    <!-- Deep Layer: Background Crypto Mesh Canvas -->
    <CryptoGraph />

    <!-- Foreground Layer: Content with High-Contrast Depth -->
    <div class="container hero-content-container">
      <div class="hero-content">
        <!-- Cryptographic Status Badge -->
        <div class="hero-badge font-mono">
	  <span class="badge-text">SIGNAL PROTOCOL &bull; ENCRYPTED CHATS</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-title font-mono text-accent">
          DeezChatz
        </h1>

        <h2 class="hero-tagline font-mono">
          Ain't nobody reading deez chats.
        </h2>

        <!-- Description Body -->
        <div class="hero-desc-wrapper">
          <p class="hero-description">
            Lock down your chats with top-tier encryption. Ain't nobody paying to store your 3 AM convos, so you can spill the tea completely lowkey.
            <span class="hero-punchline font-mono">Your business is your business, none of our business.</span>
          </p>
        </div>

        <!-- CTA Action Buttons -->
        <div class="hero-actions font-mono">
          <a href="https://github.com/deez-in/deezchatz-mobile/releases" target="_blank" rel="noopener noreferrer" class="btn-tech btn-tech-primary hero-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
            </svg>
            <span>Download on GitHub</span>
          </a>

          <a href="mailto:admin@deez.in?subject=Hiring%20Inquiry%20via%20DeezChatz" class="btn-tech btn-tech-outline hero-btn">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span>Hire Us</span>
          </a>
        </div>

        <!-- Key Metrics Foreground Strip -->
        <div class="metrics-strip tech-card font-mono">
          <div class="metric-item">
            <span class="metric-num">0</span>
            <span class="metric-label">Messages Stored</span>
          </div>
          <div class="metric-divider">/</div>
          <div class="metric-item">
            <span class="metric-num">100%</span>
            <span class="metric-label">Privacy Guaranteed</span>
          </div>
          <div class="metric-divider">/</div>
          <div class="metric-item">
            <span class="metric-num">Max</span>
            <span class="metric-label">Encryption</span>
          </div>
          <div class="metric-divider">/</div>
          <div class="metric-item">
            <span class="metric-num">Free</span>
            <span class="metric-label">As in FREEDOM</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Ratchet Simulation Section -->
  <LiveEncryptionDemo />

  <!-- Ecosystem / Architecture Crates Section -->
  <Ecosystem />

  <!-- Security Features / Bento Grid Section -->
  <SecurityFeatures />

  <!-- Open Source / GitHub Section -->
  <OpenSource />

  <!-- Technical FAQ & Contact Section -->
  <Faq />
</Layout>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 4.5rem 5.5rem;
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding-block: 6rem 7rem;
    }
  }

  .hero-content-container {
    position: relative;
    z-index: 10;
  }

  .hero-content {
    max-width: 42rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .hero-title {
    font-size: clamp(1.75rem, 6vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .text-accent {
    color: var(--accent-primary);
    background: linear-gradient(135deg, var(--accent-primary) 0%, #fbbf24 60%, var(--accent-cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-tagline {
    font-size: clamp(1.25rem, 4vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    line-height: 1.3;
  }

  .hero-desc-wrapper {
    padding-left: 1.125rem;
    border-left: 2px solid var(--accent-primary);
    margin-bottom: 2.25rem;
  }

  .hero-description {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .hero-punchline {
    display: block;
    margin-top: 0.5rem;
    color: var(--accent-primary);
    font-size: 0.9375rem;
    font-weight: 700;
  }


  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 3.25rem;
    position: relative;
    z-index: 20;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    height: 2.75rem;
    padding: 0 1.375rem;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    box-sizing: border-box;
  }

  .hero-btn svg {
    flex-shrink: 0;
  }

  .metrics-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.25rem 2rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: border-color 0.25s ease;
  }

  .metrics-strip:hover {
    border-color: rgba(250, 204, 21, 0.35);
  }

  @media (max-width: 640px) {
    .metrics-strip {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      width: 100%;
    }
    .metric-divider {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .metrics-strip {
      grid-template-columns: 1fr;
    }
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    cursor: default;
    transition: transform 0.2s ease;
  }

  .metric-item:hover {
    transform: translateY(-1px);
  }

  .metric-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .metric-item:hover .metric-num {
    color: var(--accent-primary);
  }

  .metric-label {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }

  .metric-item:hover .metric-label {
    color: var(--text-secondary);
  }

  .metric-divider {
    color: var(--border-color);
    font-weight: 300;
  }
</style>

<script>
  const exploreBtn = document.getElementById('explore-graph-btn');
  exploreBtn?.addEventListener('click', () => {
    if (typeof (window as any).toggleCryptoGraph === 'function') {
      (window as any).toggleCryptoGraph();
    }
  });
</script>
