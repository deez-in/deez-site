---
import Layout from '../layouts/Layout.astro';
import DeleteInitialView from '../components/delete-user/DeleteInitialView.astro';
import DeleteStatusViews from '../components/delete-user/DeleteStatusViews.astro';
import DeleteModal from '../components/delete-user/DeleteModal.astro';
import '../styles/delete-user.css';

const GOOGLE_CLIENT_ID = '715076094331-7mtbcp2hvd382r645ss6tsri18ekk6om.apps.googleusercontent.com';
const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.chatz.deez.in';
---

<Layout
  title="Delete Account | DeezChatz"
  description="Request permanent deletion of your DeezChatz backend account and disconnect registered devices."
  currentPath="/delete-user"
>
  <div class="delete-page" data-api-url={API_URL} data-client-id={GOOGLE_CLIENT_ID}>
    <div class="container">
      <!-- Breadcrumb & Header -->
      <div class="page-header">
        <nav class="breadcrumb font-mono" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">Account</span>
          <span class="sep">/</span>
          <span class="current">Delete User</span>
        </nav>

        <div class="badge-tag font-mono section-badge">
          <span class="pulse-indicator"></span>
          <span>ACCOUNT DELETION PROTOCOL // CLOUD REGISTRY REMOVAL</span>
        </div>

        <h1 class="page-title font-mono">Delete User Account</h1>
        <p class="page-subtitle">
          Manage your account lifecycle, revoke cloud identity credentials, and sever connected client devices.
        </p>
      </div>

      <!-- Main Container Area with Views -->
      <div class="delete-content-wrapper">
        <DeleteInitialView />
        <DeleteStatusViews />
      </div>
    </div>
  </div>

  <!-- Irreversible Confirmation Modal -->
  <DeleteModal />
</Layout>

<script src="../scripts/delete-user.ts"></script>
