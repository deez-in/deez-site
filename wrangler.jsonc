{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "deez-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "deez.in",
			"custom_domain": true
		},
		{
			"pattern": "chatz.deez.in",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}